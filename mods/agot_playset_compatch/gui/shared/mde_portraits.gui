	type mde_view_kingsguard_portrait_head_small = widget {
		size = { 85 90 }

		background = {
			using = Background_Area_Solid

			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
				blend_mode = alphamultiply
				alpha = 0.2
				mirror = vertical
			}
		}

		background = {
			block "empty_character" {}
			visible = "[Not( Character.HasLandedTitles )]"
			texture = "gfx/portraits/portrait_frame.dds"
			using = Color_Grey
			margin = { -4 -4 }
			alpha = 0.4
		}

		widget = {
			size = { 100% 100% }
			using = Portrait_Background_Glows

			block "empty_character" {}
		}

		portrait_button = {
			#AGOT Added
			using = visible_if_not_dragon
			parentanchor = bottom|hcenter
			size = { 80 100 }
			using = portrait_base

			block "portrait_texture"
			{
				portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			}

			mask = "gfx/portraits/portrait_mask_head_small.dds"
			effectname = "NoHighlight"

			highlight_icon = {
				name = "prison_bars"
				visible = "[Character.IsImprisoned]"
				visible_at_creation = no
				size = { 80 88 }
				parentanchor = center
				effectname = "NoHighlight"
				texture = "gfx/portraits/portrait_prison_head.dds"

				modify_texture = {
					name = "mask"
					texture = "gfx/portraits/portrait_mask_head_small.dds"
					spriteType = Corneredstretched
					blend_mode = alphamultiply
				}
			}

			block "portrait_button" {}
		}
		#AGOT Added
		portrait_button = {
			#AGOT Added
			using = visible_if_dragon
			parentanchor = bottom|hcenter
			size = { 80 100 }
			using = portrait_base

			block "portrait_texture"
			{
				portrait_texture = "[Character.GetPortrait('environment_dragonpit_portrait', 'camera_dragon_head', 'dragon_head', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			}

			mask = "gfx/portraits/portrait_mask_head_small.dds"
			effectname = "NoHighlight"

			highlight_icon = {
				name = "prison_bars"
				visible = "[Character.IsImprisoned]"
				visible_at_creation = no
				size = { 80 88 }
				parentanchor = center
				effectname = "NoHighlight"
				texture = "gfx/portraits/portrait_prison_head.dds"

				modify_texture = {
					name = "mask"
					texture = "gfx/portraits/portrait_mask_head_small.dds"
					spriteType = Corneredstretched
					blend_mode = alphamultiply
				}
			}

			block "portrait_button" {}
		}

		widget_portrait_frame = {}

		block "coa" {
			coa_house_tiny = {
				datacontext = "[Character.GetHouse]"
				visible = "[Character.GetHouse.IsValid]"
				parentanchor = bottom|left
				position = { 1 -1 }
				scale = 0.75
			}
		}

		mde_portrait_status_icons_small = {
			parentanchor = bottom|right
			position = { 1 -3 }
		}

		widget = {
			size = { 100% 100% }
			visible = "[Not( Character.HasLandedTitles )]"
			block "empty_character" {}

			background = {
				texture = "gfx/portraits/portrait_frame.dds"
				using = Color_Grey
				margin = { -4 -4 }
				alpha = 0.4

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
					mirror = vertical
				}
			}

			background = {
				visible = "[Character.IsHovered]"
				texture = "gfx/portraits/portrait_frame.dds"
				using = Color_Grey
				alpha = 0.7
				margin = { -4 -4 }
			}
		}


		# Portrait unknown glow
		highlight_icon = {
			name = "portrait_unknown_head_small_glow"
			parentanchor = center
			position = { 3 -9 }
			gfxtype = framedbuttongfx
			effectname = "NoHighlight"
			texture = "gfx/portraits/unknown_portraits/button_unknown_head.dds"
			size = { 80 100 }
			framesize = { 384 480 }
			upframe = 1
			overframe = 2
			block "glow_visible" {

				visible = "[Not(Character.IsValid)]"
			}

			block "glow_flip" {}

			block "onclick" {}
		}
	}
	
	type mde_portrait_status_icons_small = widget {
		size = { 32 60 }
		scissor = yes

		flowcontainer = {
			visible = "[Character.IsValid]"
			ignoreinvisible = yes
			direction = vertical
			parentanchor = bottom
			spacing = 1

			

			# sorted by priority, highest prio at the bottom
			block "status_icons" {

				block "scripted_relation_status_icons"
				{
					using = Portrait_Relation_Icons_Small
				}
				container = {
					background = {
						using = Background_Area_Dark
						margin = { 2 2 }
					}
					parentanchor = right
					button_religion_icon = {
						name = "faith_button"
						datacontext = "[Character.GetFaith]"
						size = { 14 14 }
					}
				}
				flowcontainer = {
					background = {
						using = Background_Area_Dark
						margin = { 2 2 }
					}
					#direction = vertical
					text_single = {
						name = "character_age"
						#layoutpolicy_horizontal = expanding
						max_width = 14
						fontsize_min = 2

						text = "CHARACTER_VIEW_AGE"
						#default_format = "#low"
						fontsize = 8
						align = center
						tooltip = "CHARACTER_VIEW_AGE_TT"
					}
					icon = {
						visible = "[Not( Character.IsDeadAndValid )]"
						size = { 14 14 }

						framesize = { 60 60 }
						frame = "[Character.GetHealthIconFrame]"
						texture = "gfx/interface/icons/character_status/icon_health.dds"

						tooltip = "CHARACTER_VIEW_ALIVE_TT"
					
					}
				}
			}
		}
	}

}

	